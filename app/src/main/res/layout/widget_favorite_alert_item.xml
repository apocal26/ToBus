<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_alert_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/widget_alert_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_alert_row_bg"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <!-- Top row: Up to 3 affected favorite line pills + optional +N badge + status tag -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_alert_line1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge_amber"
                android:gravity="center"
                android:minWidth="26dp"
                android:paddingStart="7dp"
                android:paddingTop="1.5dp"
                android:paddingEnd="7dp"
                android:paddingBottom="1.5dp"
                android:text="4"
                android:textColor="#FF0D0D12"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_alert_line2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_badge_amber"
                android:gravity="center"
                android:minWidth="26dp"
                android:paddingStart="7dp"
                android:paddingTop="1.5dp"
                android:paddingEnd="7dp"
                android:paddingBottom="1.5dp"
                android:text="15"
                android:textColor="#FF0D0D12"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_alert_line3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_badge_amber"
                android:gravity="center"
                android:minWidth="26dp"
                android:paddingStart="7dp"
                android:paddingTop="1.5dp"
                android:paddingEnd="7dp"
                android:paddingBottom="1.5dp"
                android:text="13"
                android:textColor="#FF0D0D12"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_alert_line_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_badge_neutral"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingTop="1.5dp"
                android:paddingEnd="6dp"
                android:paddingBottom="1.5dp"
                android:text="+2"
                android:textColor="#FFFFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_alert_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:text="● In corso"
                android:textColor="#FFFBBF24"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Alert headline -->
        <TextView
            android:id="@+id/widget_alert_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="1dp"
            android:maxLines="2"
            android:text="Deviazione in Corso Vittorio Emanuele II"
            android:textColor="#FFFFFFFF"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <!-- Alert detail snippet (dynamically toggled/resized for compact vs tall widgets) -->
        <TextView
            android:id="@+id/widget_alert_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:lineSpacingExtra="1dp"
            android:maxLines="2"
            android:text="Cantiere stradale: deviazione da via Nizza a piazza Carlo Felice."
            android:textColor="#CCFFFFFF"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
