<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alerts_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_rounded"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: Status Star/Badge + Title & Monitored Lines + Optional Active Count Pill + Refresh -->
    <LinearLayout
        android:id="@+id/alerts_widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/alerts_widget_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/widget_alert_count_pill"
            android:gravity="center"
            android:text="!"
            android:textColor="#FFFBBF24"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/alerts_widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Avvisi Preferite"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/alerts_widget_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Aggiornamento…"
                android:textColor="#99FFFFFF"
                android:textSize="10.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/alerts_widget_count_pill"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_alert_count_pill"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="2 attivi"
            android:textColor="#FFFBBF24"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/alerts_widget_refresh_btn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_refresh_btn_dark"
            android:contentDescription="@string/widget_tap_to_refresh"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_refresh_light" />
    </LinearLayout>

    <!-- Scrollable list of active/upcoming alerts or clean All-Clear / Empty card -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/alerts_widget_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"
            android:fadeScrollbars="false"
            android:fadingEdgeLength="22dp"
            android:paddingBottom="18dp"
            android:paddingEnd="5dp"
            android:requiresFadingEdge="vertical"
            android:scrollbarSize="2.5dp"
            android:scrollbarStyle="outsideOverlay"
            android:scrollbarThumbVertical="@drawable/widget_scrollbar_thumb"
            android:scrollbars="vertical" />

        <FrameLayout
            android:id="@+id/alerts_widget_scroll_hint"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_gravity="bottom"
            android:background="@drawable/widget_bottom_scroll_fade"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="15dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="1dp"
                android:background="@drawable/widget_scroll_chevron_pill"
                android:contentDescription="@null"
                android:padding="1dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_chevron_down" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/alerts_widget_empty_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_alert_ok_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/alerts_widget_empty_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="✓ Servizio regolare"
                android:textColor="#FF34D399"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/alerts_widget_empty_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="3"
                android:text="Nessun avviso o deviazione attiva sulle tue linee preferite."
                android:textColor="#C8FFFFFF"
                android:textSize="11.5sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
