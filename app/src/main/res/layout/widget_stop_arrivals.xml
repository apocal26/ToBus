<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stop_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_rounded"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: Star + Stop Name + #Code & Update Time + Optional Favorite Switcher + Refresh -->
    <LinearLayout
        android:id="@+id/stop_widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/stop_widget_star"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="★"
            android:textColor="#FFFBBF24"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/stop_widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Fermata Live"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/stop_widget_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Aggiornamento…"
                android:textColor="#99FFFFFF"
                android:textSize="10.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/stop_widget_switch_btn"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_pill_dark"
            android:gravity="center"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:text="1/2 ›"
            android:textColor="#F0FFFFFF"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/stop_widget_refresh_btn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_refresh_btn_dark"
            android:contentDescription="@string/widget_tap_to_refresh"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_refresh_light" />
    </LinearLayout>

    <!-- Scrollable list of ALL incoming lines grouped cleanly like the in-app Stop popup -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/stop_widget_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"
            android:fadeScrollbars="false"
            android:fadingEdgeLength="22dp"
            android:paddingBottom="18dp"
            android:paddingEnd="5dp"
            android:requiresFadingEdge="vertical"
            android:scrollbarSize="2.5dp"
            android:scrollbarStyle="outsideOverlay"
            android:scrollbarThumbVertical="@drawable/widget_scrollbar_thumb"
            android:scrollbars="vertical" />

        <!-- Subtle non-interactive bottom fade + minimal chevron hinting more lines below -->
        <FrameLayout
            android:id="@+id/stop_widget_scroll_hint"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_gravity="bottom"
            android:background="@drawable/widget_bottom_scroll_fade"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="15dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="1dp"
                android:background="@drawable/widget_scroll_chevron_pill"
                android:contentDescription="@null"
                android:padding="1dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_chevron_down" />
        </FrameLayout>

        <TextView
            android:id="@+id/stop_widget_empty_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_stop_row_bg"
            android:gravity="center"
            android:padding="14dp"
            android:text="Tocca una fermata nella Mappa di ToBus e premi ★ per vedere qui tutti i pullman in arrivo."
            android:textColor="#B8FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
